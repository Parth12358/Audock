def _src_repo():
    try:
        d = Path(__file__).resolve().parent.parent
    except NameError:
        return None
    return d if (d / "tools" / "audock").exists() and (d / "CLAUDE.md").exists() else None


def cmd_init(args):
    import json
    import shutil
    dry = getattr(args, "dry_run", False)
    target = Path(args.path or ".").resolve()
    existing = (target / ".obsidian").is_dir()
    created, skipped = [], []

    if not dry:
        for d in ["sources/conversations", "sources/web", "sources/code", "sources/manual",
                  "notes", "maps", "journal", "templates", "tools", "inbox",
                  ".claude/skills/audock", ".obsidian"]:
            (target / d).mkdir(parents=True, exist_ok=True)

    files = {
        "CLAUDE.md": EMB_CLAUDE, "index.md": EMB_INDEX, "tags.md": EMB_TAGS,
        ".gitignore": EMB_GITIGNORE,
        "templates/note.md": EMBEDDED_TEMPLATES["note"],
        "templates/source.md": EMBEDDED_TEMPLATES["source"],
        "templates/moc.md": EMBEDDED_TEMPLATES["moc"],
        ".claude/skills/audock/SKILL.md": EMB_SKILL,
        ".obsidian/app.json": EMB_APP,
    }
    for rel, content in files.items():
        p = target / rel
        if p.exists():
            skipped.append(rel)
        else:
            if not dry:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(content, encoding="utf-8")
            created.append(rel)

    # graph.json — merge our color groups into an existing graph config, else write ours
    gp = target / ".obsidian" / "graph.json"
    if gp.exists():
        try:
            g = json.loads(read(gp))
        except Exception:  # noqa: BLE001
            g = {}
        groups = g.get("colorGroups") or []
        have = {grp.get("query") for grp in groups}
        added = [grp for grp in GRAPH_GROUPS if grp["query"] not in have]
        if added and not dry:
            groups.extend(added)
            g["colorGroups"] = groups
            gp.write_text(json.dumps(g, indent=2), encoding="utf-8")
        (created if added else skipped).append(
            f".obsidian/graph.json (+{len(added)} color groups, existing kept)")
    else:
        if not dry:
            (target / ".obsidian").mkdir(parents=True, exist_ok=True)
            gp.write_text(json.dumps(EMB_GRAPH, indent=2), encoding="utf-8")
        created.append(".obsidian/graph.json")

    # community-plugins.json — ensure dataview is listed, preserving any existing plugins
    cp = target / ".obsidian" / "community-plugins.json"
    if cp.exists():
        try:
            lst = json.loads(read(cp))
        except Exception:  # noqa: BLE001
            lst = []
        if "dataview" not in lst:
            if not dry:
                lst.append("dataview")
                cp.write_text(json.dumps(lst), encoding="utf-8")
            created.append(".obsidian/community-plugins.json (+dataview, existing kept)")
        else:
            skipped.append(".obsidian/community-plugins.json")
    else:
        if not dry:
            cp.write_text(json.dumps(["dataview"]), encoding="utf-8")
        created.append(".obsidian/community-plugins.json")

    # tools/audock — copy the script in when running from the repo (self-contained vault)
    taudock = target / "tools" / "audock"
    src = _src_repo()
    if taudock.exists():
        skipped.append("tools/audock")
    elif src and (src / "tools" / "audock").resolve() != taudock.resolve():
        if not dry:
            taudock.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src / "tools" / "audock", taudock)
            os.chmod(taudock, 0o755)
        created.append("tools/audock")
    else:
        skipped.append("tools/audock (use the installed `audock` binary, or copy the script in)")

    head = "[DRY RUN] would initialize" if dry else "Audock initialized in"
    where = " (existing Obsidian vault detected — your files/config are preserved)" if existing else ""
    print(f"{head} {target}{where}")
    for c in created:
        print(f"  {'~' if dry else '+'} {c}")
    for s in skipped:
        print(f"  = {s} (kept)")
    if dry:
        print("\n(nothing written — re-run without --dry-run to apply)")
        return
    print("\nNext:")
    print("  1) git init && git add -A && git commit -m 'add Audock'   (if not a repo yet)")
    print("  2) audock reindex && audock doctor")
    print("  3) In Obsidian: enable the Dataview community plugin.")
    if existing:
        print("  4) Your existing notes are untouched. To fold one into Audock, add frontmatter")
        print("     (type: note, id, status); mark human-owned notes `locked: true` so I never edit them.")


def main():
    ap = argparse.ArgumentParser(prog="audock", description="Audock vault librarian")
    ap.add_argument("--vault", help="vault root (else $AUDOCK_VAULT or nearest ancestor)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_new = sub.add_parser("new", help="scaffold a file from a template")
    p_new.add_argument("kind", choices=["note", "source", "moc"])
    p_new.add_argument("title")
    p_new.add_argument("--force", action="store_true")
    p_new.set_defaults(func=cmd_new)

    p_ing = sub.add_parser("ingest", help="capture raw material into sources/")
    p_ing.add_argument("source", help="file path, http(s) url, or - for stdin")
    p_ing.add_argument("--type", required=True, choices=list(KIND_TO_DIR))
    p_ing.add_argument("--title")
    p_ing.add_argument("--ref")
    p_ing.add_argument("--force", action="store_true")
    p_ing.set_defaults(func=cmd_ingest)

    p_q = sub.add_parser("query", help="search frontmatter + body")
    p_q.add_argument("text", nargs="?", default="")
    p_q.add_argument("--tag")
    p_q.add_argument("--type", choices=["note", "source", "moc", "entity"])
    p_q.add_argument("--since", help="YYYY-MM-DD; filter by updated/created")
    p_q.add_argument("--limit", type=int, default=15)
    p_q.add_argument("--all", action="store_true", help="include superseded notes")
    p_q.add_argument("--json", action="store_true")
    p_q.set_defaults(func=cmd_query)

    p_sim = sub.add_parser("similar", help="top-k notes similar to a title (dedup gate)")
    p_sim.add_argument("text")
    p_sim.add_argument("--k", type=int, default=5)
    p_sim.set_defaults(func=cmd_similar)

    p_log = sub.add_parser("log", help="append a line to today's journal")
    p_log.add_argument("message")
    p_log.set_defaults(func=cmd_log)

    p_s = sub.add_parser("show", help="print one note/source (compact, or --raw for verbatim)")
    p_s.add_argument("id", help="id / title / alias / filename stem")
    p_s.add_argument("--body", action="store_true", help="only the distilled body")
    p_s.add_argument("--raw", action="store_true", help="exact file bytes (lossless)")
    p_s.set_defaults(func=cmd_show)

    p_c = sub.add_parser("context", help="bounded answer pack for a question (cheapest query)")
    p_c.add_argument("question")
    p_c.add_argument("--tag")
    p_c.add_argument("--since", help="YYYY-MM-DD")
    p_c.add_argument("--k", type=int, default=5, help="max notes to include")
    p_c.add_argument("--max-bytes", type=int, default=6000, dest="max_bytes",
                     help="size cap for the pack")
    p_c.add_argument("--all", action="store_true", help="include superseded notes")
    p_c.set_defaults(func=cmd_context)

    p_r = sub.add_parser("reindex", help="rebuild tags.md + index.md maps list")
    p_r.set_defaults(func=cmd_reindex)

    p_d = sub.add_parser("doctor", help="orphans / broken links / dups / stale report")
    p_d.set_defaults(func=cmd_doctor)

    p_i = sub.add_parser("init", help="scaffold Audock into a new or existing Obsidian vault")
    p_i.add_argument("path", nargs="?", default=".", help="vault dir (default: current)")
    p_i.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    p_i.set_defaults(func=cmd_init)

    args = ap.parse_args()
    global VAULT
    VAULT = _resolve_vault(args.vault)
    args.func(args)


if __name__ == "__main__":
    main()
