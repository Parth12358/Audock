#!/usr/bin/env python3
"""audock — the Audock vault librarian CLI.

Zero required dependencies, no external tools — a pure-Python BM25 scan (field-weighted, light
stemming). The vault root is found via --vault, then $AUDOCK_VAULT, then the nearest ancestor of
the CWD containing notes/ & sources/, then this script's parent dir — so the in-repo script and a
released standalone binary both work.

Commands:
  init [path] [--dry-run]                          scaffold Audock into a new/existing vault
  new note|source|moc "Title"                      scaffold a file from a template
  ingest <file|url|-> --type KIND [--title ..] [--ref ..]   capture raw material into sources/
  context "question" [--tag T] [--k N] [--all]     bounded answer pack (cheapest query)
  query "text" [--tag T] [--type T] [--since DATE] [--all] [--json]   ranked BM25 search
  similar "title"                                  top-k similar notes (dedup gate)
  show <id> [--body | --raw]                       one item; --raw = verbatim/lossless
  sql "<SELECT|UPDATE|MERGE ...>" [--apply]        SQL-style bulk query/edit (dry-run default)
  backlinks <id>                                   notes/MOCs that link to this one
  view <name> [--tag T] [--type T] [--status S]    emit an Obsidian Bases (.base) saved view
  log "message"                                    append a line to today's journal
  reindex [--related]                              rebuild tags.md + index.md (+ Related blocks)
  doctor                                           hygiene report (links/orphans/dups/tags/...)
"""
import argparse
import hashlib
import json
import math
import os
import re
from collections import Counter
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone, date, timedelta
from pathlib import Path

VAULT = None  # resolved at startup by _resolve_vault()
SKIP_DIRS = {".git", ".obsidian", "templates", ".trash", "__pycache__", "inbox"}


def _resolve_vault(explicit=None):
    """Find the vault root so a released standalone binary works from anywhere:
    --vault flag > $AUDOCK_VAULT > nearest ancestor of CWD containing notes/ & sources/
    > this script's parent dir (the in-repo `<vault>/tools/audock` layout)."""
    if explicit:
        return Path(explicit).resolve()
    env = os.environ.get("AUDOCK_VAULT")
    if env:
        return Path(env).resolve()
    cur = Path.cwd().resolve()
    for d in [cur, *cur.parents]:
        if (d / "notes").is_dir() and (d / "sources").is_dir():
            return d
    try:
        return Path(__file__).resolve().parent.parent
    except NameError:  # frozen binary with no real __file__
        return cur
KIND_TO_DIR = {
    "conversation": "conversations",
    "code": "code",
    "web": "web",
    "manual": "manual",
}
STALE_DAYS = 180


# ---------- small utilities ----------

def slugify(text):
    text = text.strip().lower()
    text = re.sub(r"[^\w\s-]", "", text)
    text = re.sub(r"[\s_]+", "-", text)
    text = re.sub(r"-+", "-", text).strip("-")
    return text or "untitled"


def today():
    return date.today().isoformat()


def utc_stamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")


def utc_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def md_files(root=None):
    root = root or VAULT
    for p in sorted(root.rglob("*.md")):
        if any(part in SKIP_DIRS for part in p.relative_to(VAULT).parts):
            continue
        yield p


def read(p):
    return p.read_text(encoding="utf-8", errors="replace")


# ---------- minimal frontmatter parser (no PyYAML needed) ----------

def _strip_q(v):
    """Unquote a YAML scalar. Double-quoted values honor escapes (\\", \\\\, \\uXXXX — JSON's escape
    set is a subset of YAML's); single-quoted values unescape '' to '."""
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] == '"':
        try:
            out = json.loads(v)
            return out if isinstance(out, str) else v[1:-1]
        except ValueError:
            return v[1:-1]
    if len(v) >= 2 and v[0] == v[-1] == "'":
        return v[1:-1].replace("''", "'")
    return v


def _split_inline_list(inner):
    out, buf, depth, q = [], "", 0, None
    for ch in inner:
        if q:
            buf += ch
            if ch == q:
                q = None
        elif ch in "\"'":
            q = ch
            buf += ch
        elif ch in "[":
            depth += 1
            buf += ch
        elif ch in "]":
            depth -= 1
            buf += ch
        elif ch == "," and depth == 0:
            out.append(buf)
            buf = ""
        else:
            buf += ch
    if buf.strip():
        out.append(buf)
    return [_strip_q(x) for x in out]


def parse_frontmatter(text):
    """Return (dict, body). Tolerant of scalars, inline [lists], and block - lists."""
    text = text.lstrip("﻿")  # tolerate a UTF-8 BOM (Windows editors) — else frontmatter hides
    text = text.replace("\r\n", "\n")  # CRLF files parse the same as LF
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return {}, text
    fm_lines = lines[1:end]
    body = "\n".join(lines[end + 1:])
    data = {}
    i, n = 0, len(fm_lines)
    while i < n:
        line = fm_lines[i]
        if not line.strip() or line.strip().startswith("#"):
            i += 1
            continue
        m = re.match(r"^([A-Za-z0-9_\-]+):\s*(.*)$", line)
        if not m:
            i += 1
            continue
        key, val = m.group(1).strip(), m.group(2).strip()
        if val == "":
            items, j = [], i + 1
            while j < n and re.match(r"^\s*-\s+", fm_lines[j]):
                items.append(_strip_q(re.sub(r"^\s*-\s+", "", fm_lines[j]).strip()))
                j += 1
            if items:
                data[key] = items
                i = j
                continue
            data[key] = ""
            i += 1
            continue
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            data[key] = _split_inline_list(inner) if inner else []
        else:
            data[key] = _strip_q(val)
        i += 1
    return data, body


def as_list(v):
    if v is None or v == "":
        return []
    return v if isinstance(v, list) else [v]


# ---------- template instantiation ----------

# Embedded fallbacks so a standalone binary works without the vault's templates/ dir.
# When templates/<name>.md exists in the vault it takes precedence (Obsidian-editable).
EMBEDDED_TEMPLATES = {
    "note": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: note\ntags: []\nsummary: \n"
        "created: __DATE__\nupdated: __DATE__\naliases: []\nsources: []\n"
        "status: draft\nsuperseded_by: \nlocked: false\n---\n\n# __TITLE__\n\n"
        "<!-- One concept per note. Distilled, not verbatim. Link liberally with [[other-note]]. -->\n"
        "<!-- summary: = one line — what this note claims + where it came from (boosts retrieval). -->\n"
        "<!-- When superseded, set status: superseded and superseded_by: \"[[new-note]]\". -->\n"
        "<!-- locked: true => human-owned; Claude must NOT edit, supersede, move, or delete. -->\n\n"
        "## Log\n- __DATE__ — created\n"
    ),
    "source": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: source\norigin: __ORIGIN__\n"
        "origin_ref: __ORIGIN_REF__\ncaptured: __TS__\nhash: __HASH__\n"
        "distilled_into: []\n---\n__BODY__\n"
    ),
    "moc": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: moc\ntags: [moc]\ncreated: __DATE__\n"
        "updated: __DATE__\naliases: []\nstatus: stable\n---\n\n# __TITLE__\n\n"
        "## Key notes\n<!-- Curated [[wikilinks]] — the canonical entry points. -->\n\n"
        "## All notes in this domain\n```dataview\nTABLE updated, status\nFROM #__SLUG__\n"
        "WHERE type = \"note\"\nSORT updated DESC\n```\n"
    ),
}


def fill_template(name, mapping):
    f = VAULT / "templates" / f"{name}.md"
    tpl = read(f) if f.exists() else EMBEDDED_TEMPLATES[name]
    for k, v in mapping.items():
        tpl = tpl.replace(k, v)
    return tpl


def write_new(path, content, force=False):
    if path.exists() and not force:
        sys.exit(f"error: {path.relative_to(VAULT)} already exists (use a different title)")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(content.encode("utf-8"))  # no newline translation on any OS
    return path


# ---------- daily activity log ----------

def _journal(action, detail):
    """Append a dated line to journal/YYYY-MM-DD.md (an Obsidian daily note). Records what
    the librarian did, so there's a human-browsable activity trail. type: journal keeps these
    out of knowledge queries."""
    day = today()
    jdir = VAULT / "journal"
    jdir.mkdir(parents=True, exist_ok=True)
    f = jdir / f"{day}.md"
    if not f.exists():
        f.write_text(
            f"---\nid: {day}-journal\ntitle: Journal {day}\ntype: journal\ncreated: {day}\n"
            f"---\n\n# Journal {day}\n\n",
            encoding="utf-8",
        )
    with f.open("a", encoding="utf-8") as fh:
        fh.write(f"- {datetime.now().strftime('%H:%M')} — {action}: {detail}\n")


# ---------- commands ----------

def cmd_log(args):
    _journal("note", args.message)
    print(f"logged to journal/{today()}.md")


def cmd_new(args):
    title = args.title
    slug = slugify(title)
    d = today()
    if args.kind == "note":
        content = fill_template("note", {
            "__ID__": f"{d.replace('-', '')}-{slug}",
            "__TITLE__": title,
            "__DATE__": d,
        })
        path = write_new(VAULT / "notes" / f"{slug}.md", content, args.force)
    elif args.kind == "moc":
        content = fill_template("moc", {
            "__ID__": f"{d.replace('-', '')}-{slug}",
            "__TITLE__": title,
            "__DATE__": d,
            "__SLUG__": slug,
        })
        path = write_new(VAULT / "maps" / f"{slug}.md", content, args.force)
    elif args.kind == "source":
        ts = utc_stamp()
        content = fill_template("source", {
            "__ID__": f"{ts}-{slug}",
            "__TITLE__": title,
            "__ORIGIN__": "manual",
            "__ORIGIN_REF__": "manual",
            "__TS__": utc_iso(),
            "__HASH__": "sha256:(none)",
            "__BODY__": "",
        })
        path = write_new(VAULT / "sources" / "manual" / f"{ts}-{slug}.md", content, args.force)
    print(f"created {path.relative_to(VAULT)}")
    _journal(f"new {args.kind}", f"{title} ({path.relative_to(VAULT)})")


MAX_FETCH = 8_000_000  # bytes; larger pages are refused rather than silently truncated


def _check_host(host):
    """SSRF guard. Refuse a host if ANY address it resolves to (IPv4 or IPv6) is not public
    internet space. Fails closed: an unresolvable host is an error, not a pass."""
    import ipaddress
    import socket
    if not host:
        sys.exit("error: URL has no host")
    try:
        infos = socket.getaddrinfo(host, None)
    except socket.gaierror as e:
        sys.exit(f"error: cannot resolve {host}: {e}")
    for info in infos:
        ip = ipaddress.ip_address(info[4][0].split("%")[0])
        if getattr(ip, "ipv4_mapped", None):
            ip = ip.ipv4_mapped
        if not ip.is_global:
            sys.exit(f"error: refused to fetch {host}: it resolves to non-public address {ip}")


def _fetch_url(src):
    """Fetch a URL for ingest. Every redirect hop is re-checked by the SSRF guard, and any
    failure (refusal, network error, oversize page) exits non-zero. Nothing is captured on
    failure, because sources/ is append-only and a bogus capture could never be fixed."""
    import urllib.parse

    class _GuardedRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            _check_host(urllib.parse.urlparse(newurl).hostname)
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    _check_host(urllib.parse.urlparse(src).hostname)
    opener = urllib.request.build_opener(_GuardedRedirects)
    req = urllib.request.Request(src, headers={"User-Agent": "audock/1.0"})
    try:
        with opener.open(req, timeout=20) as r:
            data = r.read(MAX_FETCH + 1)
    except SystemExit:
        raise
    except Exception as e:  # noqa: BLE001
        sys.exit(f"error: could not fetch {src}: {e}")
    if len(data) > MAX_FETCH:
        sys.exit(f"error: {src} is larger than {MAX_FETCH} bytes; refusing a truncated capture")
    return data.decode("utf-8", errors="replace")


def _load_body(src, kind):
    """Return (body_text, origin_ref) for ingest input."""
    if src == "-":
        # bytes, not text mode: text mode may translate newlines and break byte-verbatim capture
        return sys.stdin.buffer.read().decode("utf-8", errors="replace"), "stdin"
    if re.match(r"^https?://", src, re.I):
        return _fetch_url(src), src
    p = Path(src)
    if p.exists():
        return p.read_bytes().decode("utf-8", errors="replace"), str(p)  # keep \r\n verbatim
    sys.exit(f"error: no such file/url: {src}")


def cmd_ingest(args):
    kind = args.type
    if kind not in KIND_TO_DIR:
        sys.exit(f"error: --type must be one of {', '.join(KIND_TO_DIR)}")
    body, ref = _load_body(args.source, kind)
    ref = args.ref or ref
    title = args.title or (Path(ref).name if ref not in ("stdin",) else f"{kind} capture")
    slug = slugify(title)
    ts = utc_stamp()
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
    source_id = f"{ts}-{slug}"

    # dedup by hash across existing sources
    for existing in (VAULT / "sources").rglob("*.md"):
        fm, _ = parse_frontmatter(read(existing))
        if str(fm.get("hash", "")).endswith(digest):
            print(f"duplicate: identical content already captured at "
                  f"{existing.relative_to(VAULT)} ([[{fm.get('id')}]])")
            print("skipping re-capture. Distill from the existing source.")
            return

    content = fill_template("source", {
        "__ID__": source_id,
        "__TITLE__": title,
        "__ORIGIN__": kind,
        "__ORIGIN_REF__": ref,
        "__TS__": utc_iso(),
        "__HASH__": f"sha256:{digest}",
        "__BODY__": body,  # stored verbatim — the body below the frontmatter is the ground truth
    })
    out = write_new(VAULT / "sources" / KIND_TO_DIR[kind] / f"{source_id}.md", content, args.force)
    print(f"captured {out.relative_to(VAULT)}")
    print(f"source id: {source_id}")
    _journal(f"ingest({kind})", f"{title} ([[{source_id}]])")
    print(f"next: check for an existing note first  →  tools/audock similar \"{title}\"")
    print("then distill: tools/audock new note \"<Concept>\"  and set "
          f"sources: [\"[[{source_id}]]\"]")


# ---------- ranking: field-weighted BM25 (Okapi) with light stemming ----------
# BM25 adds term-rarity (IDF) + length normalization over naive term counts; field weights
# make a hit in the title/summary count more than one in the body. Defaults k1=1.2, b=0.75.
STOPWORDS = {
    "a", "an", "the", "of", "to", "in", "on", "for", "and", "or", "is", "are", "be", "do",
    "does", "how", "what", "why", "when", "which", "who", "that", "this", "with", "as", "by",
    "it", "its", "from", "at", "we", "i", "you", "can", "should", "would", "about", "into",
    "was", "were", "has", "have", "had", "will", "me", "my",
}
K1, B = 1.2, 0.75
FIELD_W = {"title": 6, "summary": 4, "aliases": 3, "tags": 2, "body": 1}


def _words(text):
    """Lowercase word tokens, unicode-aware (splits `domain/ml` → domain, ml; keeps accents/CJK);
    drops the underscore and stopwords."""
    return [w for w in re.findall(r"[^\W_]+", str(text).lower(), re.UNICODE)
            if len(w) >= 2 and w not in STOPWORDS]


def _stem(w):
    """Light suffix stripping so plurals/gerunds match (embeddings≈embedding; applies in order)."""
    if len(w) > 4 and w.endswith("ies"):
        w = w[:-3] + "y"
    else:
        # "-es" is a plural ending only after s/x/z/ch/sh (boxes, buses, matches); otherwise the
        # "e" belongs to the word (notes → note). Words ending in -ss/-us/-is keep their s
        # (class, status, analysis), so singular and plural stem identically.
        if len(w) > 4 and w.endswith("es") and w[:-2].endswith(("s", "x", "z", "ch", "sh")):
            w = w[:-2]
        if len(w) > 3 and w.endswith("s") and not w.endswith(("ss", "us", "is")):
            w = w[:-1]
    if len(w) > 5 and w.endswith("ing"):
        w = w[:-3]
    elif len(w) > 5 and w.endswith("ed"):
        w = w[:-2]
    return w


def _terms(text):
    return [_stem(w) for w in _words(text)]


def _first_line(body):
    for line in body.split("\n"):
        ls = line.strip()
        if ls and not ls.startswith(("#", "<!--", "---", "```")):
            return ls
    return ""


def _snippet(words, body):
    for line in body.split("\n"):
        ls = line.strip()
        if ls and not ls.startswith(("---", "<!--")) and any(w in ls.lower() for w in words):
            return ls[:160]
    return _first_line(body)[:160]


def _doc_bag(fm, body):
    """Field-weighted stemmed term frequencies for one document."""
    bag = Counter()
    for t in _terms(fm.get("title", "")):
        bag[t] += FIELD_W["title"]
    for t in _terms(fm.get("summary", "")):
        bag[t] += FIELD_W["summary"]
    for t in _terms(" ".join(as_list(fm.get("aliases")))):
        bag[t] += FIELD_W["aliases"]
    for t in _terms(" ".join(as_list(fm.get("tags")))):
        bag[t] += FIELD_W["tags"]
    for t in _terms(body):
        bag[t] += FIELD_W["body"]
    return bag


def _corpus(include_superseded=False):
    """All indexed, searchable docs with their term bags (excludes docs with no type,
    journal entries, and — unless asked — superseded notes)."""
    docs = []
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        if not fm.get("type") or str(fm.get("type")) == "journal":
            continue
        if not include_superseded and str(fm.get("status", "")).lower() == "superseded":
            continue
        docs.append((p, fm, body, _doc_bag(fm, body)))
    return docs


def _search(term, tag=None, type_=None, since=None, include_superseded=False):
    """Field-weighted BM25 ranking with optional filters. Journal always excluded; superseded
    excluded unless include_superseded. Filters are applied after corpus stats so IDF is stable."""
    docs = _corpus(include_superseded)
    n = len(docs) or 1
    df = Counter()
    total_len = 0
    for _, _, _, bag in docs:
        total_len += sum(bag.values())
        for t in bag:
            df[t] += 1
    avgdl = total_len / n
    qterms = set(_terms(term))
    qwords = _words(term)
    phrase = term.strip().lower()
    results = []
    for p, fm, body, bag in docs:
        if type_ and str(fm.get("type", "")) != type_:
            continue
        if tag and tag not in as_list(fm.get("tags")):
            continue
        if since:
            stamp = str(fm.get("updated") or fm.get("created") or fm.get("captured") or "")[:10]
            if stamp and stamp < since:
                continue
        if not qterms:  # tag/type-only listing → neutral match so filters still return rows
            score = 1.0
        else:
            dl = sum(bag.values()) or 1
            score = 0.0
            for t in qterms:
                f = bag.get(t, 0)
                if not f:
                    continue
                idf = math.log(1 + (n - df[t] + 0.5) / (df[t] + 0.5))
                score += idf * (f * (K1 + 1)) / (f + K1 * (1 - B + B * dl / avgdl))
            # exact-phrase bonus for genuine multi-word phrases only; a single word relies on
            # word-level term matching (substring here would match "thing" inside "everything").
            if " " in phrase and phrase in body.lower():
                score += 1.0
            if score <= 0:
                continue
        results.append({
            "path": str(p.relative_to(VAULT)),
            "id": fm.get("id", ""),
            "title": fm.get("title", ""),
            "type": fm.get("type", ""),
            "tags": as_list(fm.get("tags")),
            "score": round(score, 2),
            "snippet": _snippet(qwords, body),
        })
    results.sort(key=lambda r: (-r["score"], r["path"]))
    return results


def _resolve(ident):
    """Resolve an id / title / alias / filename-stem to (path, fm, body) or None."""
    t = ident.strip().lower()
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        keys = {str(fm.get("id", "")).lower(), str(fm.get("title", "")).lower(), p.stem.lower()}
        keys |= {a.lower() for a in as_list(fm.get("aliases"))}
        if t in keys:
            return p, fm, body
    return None


def _compact_body(body):
    """Comment-stripped, trimmed body — the minimum tokens needed to convey the note."""
    return _COMMENT_RE.sub("", body).strip()


def cmd_show(args):
    """Print a single note/source cheaply: minimal frontmatter + comment-stripped body.
    --raw gives the exact file (use for lossless drill-down into a source capture)."""
    hit = _resolve(args.id)
    if not hit:
        sys.exit(f"not found: {args.id}")
    p, fm, body = hit
    if args.raw:
        sys.stdout.flush()
        sys.stdout.buffer.write(p.read_bytes())  # exact bytes on disk
        sys.stdout.buffer.flush()
        return
    clean = _compact_body(body)
    if args.body:
        print(clean)
        return
    for k in ("id", "title", "type", "tags", "summary", "sources", "status",
              "superseded_by", "updated"):
        v = fm.get(k)
        if v:
            print(f"{k}: {', '.join(v) if isinstance(v, list) else v}")
    print()
    print(clean)


def cmd_context(args):
    """One call → a bounded, deduped, comment-stripped answer pack for a question.
    This is the cheapest way to answer: no frontmatter noise, no whole-file reads,
    size-capped, with explicit note of anything omitted (never a silent cap)."""
    sup = getattr(args, "all", False)
    results = _search(args.question, tag=args.tag, type_="note", since=args.since,
                      include_superseded=sup)
    from_sources = False
    if not results:
        # Fall back to raw sources: the vault may hold the answer undistilled. Returning
        # "nothing" when a source matches would be a correctness (recall) failure.
        results = _search(args.question, tag=args.tag, type_="source", since=args.since)
        from_sources = True
    if not results:
        print("no matches — the vault has nothing on this. Consider INGEST.")
        return
    if from_sources:
        print("[no distilled note yet — showing raw source(s); consider distilling]\n")
    blocks, used, shown = [], 0, 0
    for r in results[: args.k]:
        fm, body = parse_frontmatter(read(VAULT / r["path"]))
        clean = _compact_body(body)
        prov = as_list(fm.get("sources"))
        tag = "  (raw source)" if from_sources else ""
        header = f"### {fm.get('title', r['id'])}  [[{fm.get('id', '')}]]{tag}"
        if fm.get("summary"):
            header += f"\n_{fm.get('summary')}_"
        if prov:
            header += f"\nsources: {', '.join(prov)}"
        block = f"{header}\n{clean}\n"
        if shown > 0 and used + len(block) > args.max_bytes:
            break
        blocks.append(block)
        used += len(block)
        shown += 1
    print("\n".join(blocks))
    omitted = len(results) - shown
    if omitted > 0:
        print(f"\n[{omitted} more match(es) not shown (size/-k cap). "
              f"Full list: audock query \"{args.question}\"]")
    print("[For verbatim quotes/numbers/code, drill to a source: audock show <source-id> --raw]")


def cmd_similar(args):
    """Top-k existing NOTES similar to a title/text — run before distilling so you can
    choose ADD / UPDATE / SUPERSEDE / NOOP instead of creating a near-duplicate."""
    results = _search(args.text, type_="note", include_superseded=True)
    if not results:
        print("no similar notes — safe to ADD a new note")
        return
    print("most similar existing notes (consider UPDATE/SUPERSEDE before adding a duplicate):")
    for r in results[: args.k]:
        print(f"[{r['score']:>3}] {r['title']}  [[{r['id']}]]  ({r['path']})")


def cmd_query(args):
    results = _search(args.text or "", tag=args.tag, type_=args.type, since=args.since,
                      include_superseded=getattr(args, "all", False))
    if args.json:
        import json
        print(json.dumps(results, indent=2))
        return
    if not results:
        print("no matches")
        return
    for r in results[: args.limit]:
        print(f"[{r['score']:>3}] {r['title']}  ({r['path']})")
        if r["tags"]:
            print(f"      tags: {', '.join(r['tags'])}")
        if r["snippet"]:
            print(f"      {r['snippet']}")
    if len(results) > args.limit:
        print(f"... {len(results) - args.limit} more (use --limit)")


def _link_graph():
    """Map each resolvable key (id/title/stem/alias, lowercased) -> list of (id, title, rel) of
    the notes/MOCs that link to it. Sources (verbatim) and journal/generated files are not link
    sources (incidental [[...]] in a capture is not a real edge)."""
    incoming = {}
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        if fm.get("type") in (None, "journal", "source"):
            continue
        rel = str(p.relative_to(VAULT))
        if rel in GENERATED:
            continue
        src = (fm.get("id") or p.stem, fm.get("title") or p.stem, rel)
        for tgt in _links(body):
            incoming.setdefault(tgt.strip().lower(), []).append(src)
    return incoming


def _keys_of(p, fm):
    keys = {str(fm.get("id", "")).lower(), str(fm.get("title", "")).lower(), p.stem.lower()}
    keys |= {a.lower() for a in as_list(fm.get("aliases"))}
    return {k for k in keys if k}


def cmd_backlinks(args):
    """Who links here — the notes/MOCs that reference this one (Claude- and grep-friendly)."""
    hit = _resolve(args.id)
    if not hit:
        sys.exit(f"not found: {args.id}")
    p, fm, body = hit
    graph = _link_graph()
    self_rel = str(p.relative_to(VAULT))
    rows, seen = [], set()
    for k in _keys_of(p, fm):
        for sid, stitle, srel in graph.get(k, []):
            if srel != self_rel and srel not in seen:
                seen.add(srel)
                rows.append((sid, stitle, srel))
    if not rows:
        print("no backlinks")
        return
    print(f"backlinks to {fm.get('title')} ([[{fm.get('id')}]]):")
    for sid, stitle, srel in sorted(rows, key=lambda r: r[2]):
        print(f"  [[{sid}|{stitle}]]  ({srel})")


def cmd_view(args):
    """Emit an Obsidian Bases (.base) saved view — a native, plugin-free interactive table.
    Requires Obsidian 1.9+. Pure YAML; opens/edits against note frontmatter."""
    import json
    name = args.name
    slug = slugify(name)
    conds = []
    if not args.all:
        conds.append('note.status != "superseded"')
    if args.tag:  # json.dumps so a value with quotes can't break/alter the filter YAML
        conds.append(f"file.hasTag({json.dumps(args.tag)})")
    conds.append(f"note.type == {json.dumps(args.type or 'note')}")
    if args.status:
        conds.append(f"note.status == {json.dumps(args.status)}")
    filt = "\n".join(f"    - {c}" for c in conds)
    base = (f"filters:\n  and:\n{filt}\n"
            f"views:\n  - type: table\n    name: {json.dumps(name)}\n"
            f"    order:\n      - file.name\n      - note.summary\n      - note.status\n"
            f"      - note.updated\n    limit: 200\n")
    out = VAULT / "bases" / f"{slug}.base"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(base, encoding="utf-8")
    print(f"wrote {out.relative_to(VAULT)} (open it in Obsidian 1.9+ for a live table)")


def _replace_block(text, begin, end, new_inner):
    pat = re.compile(re.escape(begin) + r".*?" + re.escape(end), re.DOTALL)
    repl = f"{begin}\n{new_inner}\n{end}"
    if pat.search(text):
        return pat.sub(lambda _: repl, text)
    return text  # markers missing; leave untouched


# Distinct hues for auto-coloring graph groups by domain (readable in light & dark).
GRAPH_PALETTE = [0x4C8DFF, 0x57C785, 0xE0A458, 0xA66BE0, 0xE05A8A, 0x4FC3C7,
                 0xE0C040, 0xF07178, 0x9CCC65, 0x7E9CFF, 0xD98A5B, 0x5BC0BE]


_MOC_FROM_RE = re.compile(r"\bFROM\s+#([\w/\-]+)", re.I)
# Queries older Audock versions / `init` wrote; always treated as Audock-managed.
_LEGACY_GRAPH_QUERIES = {"path:notes/", "path:sources/", "path:maps/", "file:index OR file:tags"}


def _moc_domain_tags(moc_paths):
    """The tag each MOC stands for: its Dataview `FROM #tag` if present, else the most common
    tag among the notes it links to, else its filename. Returns sorted unique tags."""
    tag_of = {}
    for p in md_files(VAULT / "notes"):
        fm, _ = parse_frontmatter(read(p))
        tags = [t for t in as_list(fm.get("tags")) if t != "moc"]
        for k in _keys_of(p, fm):
            tag_of[k] = tags
    out = set()
    for p in moc_paths:
        fm, body = parse_frontmatter(read(p))
        m = _MOC_FROM_RE.search(body)
        if m:
            out.add(m.group(1))
            continue
        counts = Counter(t for tgt in _links(body) for t in tag_of.get(tgt.strip().lower(), []))
        out.add(counts.most_common(1)[0][0] if counts else p.stem)
    return sorted(out)


def _apply_graph_colors(moc_paths):
    """Color the Obsidian graph by domain: one hue per MOC's tag, plus maps, sources, and
    index/tags. Only groups Audock itself manages are replaced (tracked in
    .obsidian/audock-graph.json); the user's own groups and every other graph setting are kept.
    An unparseable graph.json is left alone. Returns the number of managed groups written."""
    import json
    ob = VAULT / ".obsidian"
    if not ob.is_dir():
        return 0  # not an Obsidian vault; don't create config
    gp, side = ob / "graph.json", ob / "audock-graph.json"
    if gp.exists():
        try:
            g = json.loads(read(gp))
            if not isinstance(g, dict):
                raise ValueError("graph.json is not an object")
        except Exception as e:  # noqa: BLE001
            print(f"warning: leaving .obsidian/graph.json untouched (cannot parse: {e})",
                  file=sys.stderr)
            return 0
    else:
        g = {k: v for k, v in EMB_GRAPH.items() if k != "colorGroups"}
    try:
        managed = set(json.loads(read(side))) if side.exists() else set()
    except Exception:  # noqa: BLE001
        managed = set()
    managed |= _LEGACY_GRAPH_QUERIES
    ours = [{"query": f"tag:#{t}", "color": {"a": 1, "rgb": GRAPH_PALETTE[i % len(GRAPH_PALETTE)]}}
            for i, t in enumerate(_moc_domain_tags(moc_paths))]
    ours += [{"query": "path:maps/", "color": {"a": 1, "rgb": 0xC8C8C8}},
             {"query": "path:sources/", "color": {"a": 1, "rgb": 0x8A8F98}},
             {"query": "file:index OR file:tags", "color": {"a": 1, "rgb": 0xE05A5A}}]
    ours_q = {grp["query"] for grp in ours}
    keep = [grp for grp in (g.get("colorGroups") or [])
            if isinstance(grp, dict) and grp.get("query") not in managed | ours_q]
    g["colorGroups"] = keep + ours
    gp.write_text(json.dumps(g, indent=2), encoding="utf-8")
    side.write_text(json.dumps(sorted(ours_q)), encoding="utf-8")
    return len(ours)


def cmd_reindex(args):
    # 1) tags.md static block
    tag_map = {}
    for p in md_files(VAULT / "notes"):
        fm, _ = parse_frontmatter(read(p))
        for tag in as_list(fm.get("tags")):
            tag_map.setdefault(tag, []).append(fm.get("id") or p.stem)
    lines = []
    for tag in sorted(tag_map):
        ids = sorted(tag_map[tag])
        links = " ".join(f"[[{i}]]" for i in ids)
        lines.append(f"- `#{tag}` ({len(ids)}): {links}")
    inner = "\n".join(lines) if lines else "- (no tags yet)"
    tags_path = VAULT / "tags.md"
    tags_path.write_text(
        _replace_block(read(tags_path) if tags_path.exists() else EMB_TAGS,
                       "<!-- AUDOCK:TAGS:BEGIN -->", "<!-- AUDOCK:TAGS:END -->", inner),
        encoding="utf-8",
    )

    # 2) index.md maps list
    maps, moc_paths = [], []
    for p in md_files(VAULT / "maps"):
        fm, _ = parse_frontmatter(read(p))
        maps.append((fm.get("title") or p.stem, fm.get("id") or p.stem))
        moc_paths.append(p)
    maps_inner = ("\n".join(f"- [[{mid}|{title}]]" for title, mid in sorted(maps))
                  if maps else "- (none yet)")
    index_path = VAULT / "index.md"
    index_path.write_text(
        _replace_block(read(index_path) if index_path.exists() else EMB_INDEX,
                       "<!-- AUDOCK:MAPS:BEGIN -->", "<!-- AUDOCK:MAPS:END -->", maps_inner),
        encoding="utf-8",
    )

    # 3) optional: write an auto-maintained `## Related` (backlinks) block into each note
    related_n = 0
    if getattr(args, "related", False):
        graph = _link_graph()
        BEG, END = "<!-- AUDOCK:RELATED:BEGIN -->", "<!-- AUDOCK:RELATED:END -->"
        for p in md_files(VAULT / "notes"):
            fm, body = parse_frontmatter(read(p))
            if fm.get("type") != "note" or _is_locked(fm):
                continue  # never write into human-owned notes
            self_rel = str(p.relative_to(VAULT))
            rows, seen = [], set()
            for k in _keys_of(p, fm):
                for sid, stitle, srel in graph.get(k, []):
                    if srel != self_rel and srel not in seen:
                        seen.add(srel)
                        rows.append(f"- [[{sid}|{stitle}]]")
            inner = "\n".join(sorted(rows)) if rows else "- (none)"
            raw = read(p)
            if BEG in raw:
                new = _replace_block(raw, BEG, END, inner)
            else:
                new = raw.rstrip() + f"\n\n## Related\n{BEG}\n{inner}\n{END}\n"
            if new != raw:
                p.write_text(new, encoding="utf-8")
                related_n += 1
    # 4) auto-color graph groups by domain (one hue per MOC)
    ncolors = _apply_graph_colors(moc_paths)
    tail = f", {related_n} related blocks" if getattr(args, "related", False) else ""
    print(f"reindexed: {len(tag_map)} tags, {len(maps)} maps, {ncolors} graph colors{tail}")


LINK_RE = re.compile(r"\[\[([^\]|#]+)(?:[#|][^\]]*)?\]\]")
_FENCE_RE = re.compile(r"```.*?```", re.DOTALL)
_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
_INLINE_RE = re.compile(r"`[^`]*`")
_RELATED_RE = re.compile(r"<!-- AUDOCK:RELATED:BEGIN -->.*?<!-- AUDOCK:RELATED:END -->", re.DOTALL)


def _strip_noise(body):
    """Drop the auto-generated Related block, code fences, HTML comments, and inline code so only
    real authored prose links remain. The Related block is derived FROM backlinks, so counting it
    would create reciprocal edges that mask orphans and feed on itself across reindexes."""
    body = _RELATED_RE.sub("", body)
    body = _FENCE_RE.sub("", body)
    body = _COMMENT_RE.sub("", body)
    body = _INLINE_RE.sub("", body)
    return body


def _links(body):
    return LINK_RE.findall(_strip_noise(body))


def _resolvable_names():
    """Set of lowercased names that a [[link]] may legitimately target."""
    names = set()
    for p in md_files():
        fm, _ = parse_frontmatter(read(p))
        for v in (fm.get("id"), fm.get("title"), p.stem):
            if v:
                names.add(str(v).lower())
        for a in as_list(fm.get("aliases")):
            names.add(a.lower())
    return names


# Auto-generated indexes list every note; links from them are not semantic backlinks.
GENERATED = {"tags.md", "index.md"}


def cmd_doctor(args):
    names = _resolvable_names()
    notes, incoming, broken = [], {}, []
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        rel = str(p.relative_to(VAULT))
        if fm.get("type") == "note":
            notes.append((p, fm, body))  # keep body to avoid re-reading each note later
        # Generated indexes and the journal list/mention notes but aren't semantic backlinks;
        # source bodies are verbatim captures (any [[...]] in them is incidental, not a link).
        if rel in GENERATED or fm.get("type") in ("journal", "source"):
            continue
        for target in _links(body):
            tgt = target.strip()
            if tgt.lower() not in names:
                broken.append((rel, tgt))
            else:
                incoming[tgt.lower()] = incoming.get(tgt.lower(), 0) + 1

    # orphans: type==note with no incoming link by id/title/filename
    incoming_set = set(incoming)
    orphans = []
    for p, fm, _ in notes:
        keys = {str(fm.get("id", "")).lower(), str(fm.get("title", "")).lower(), p.stem.lower()}
        keys |= {a.lower() for a in as_list(fm.get("aliases"))}
        if not (keys & incoming_set):
            orphans.append(str(p.relative_to(VAULT)))

    # duplicate candidates: same slugified title
    by_slug = {}
    for p, fm, _ in notes:
        by_slug.setdefault(slugify(str(fm.get("title", p.stem))), []).append(
            str(p.relative_to(VAULT)))
    dups = {k: v for k, v in by_slug.items() if len(v) > 1}

    # stale: updated older than STALE_DAYS
    cutoff = (date.today() - timedelta(days=STALE_DAYS)).isoformat()
    stale = []
    for p, fm, _ in notes:
        stamp = str(fm.get("updated") or fm.get("created") or "")[:10]
        if stamp and stamp < cutoff:
            stale.append((str(p.relative_to(VAULT)), stamp))

    # names that resolve to an actual capture, for provenance checking
    source_names = set()
    for p in md_files(VAULT / "sources"):
        sfm, _ = parse_frontmatter(read(p))
        source_names.add(str(sfm.get("id", "")).lower())
        source_names.add(p.stem.lower())

    # notes whose sources: cite a capture that no longer exists (broken provenance)
    missing_src, underlinked = [], []
    for p, fm, body in notes:
        rel = str(p.relative_to(VAULT))
        for s in as_list(fm.get("sources")):
            tgts = _links(s) or [s]
            for t in tgts:
                if t.strip().lower() not in source_names:
                    missing_src.append(f"{rel} -> {t}")
        # under-linked: fewer than 2 outgoing wikilinks (weakly wired into the graph)
        if len(_links(body)) < 2:
            underlinked.append(rel)

    # tag hygiene: tags that normalize to the same key (case/plural/_-/ variants) → merge
    norm = {}
    for _, fm, _ in notes:
        for tg in as_list(fm.get("tags")):
            key = "/".join(_stem(seg) for seg in str(tg).lower().replace("_", "-").split("/"))
            norm.setdefault(key, set()).add(tg)
    tag_variants = {k: sorted(v) for k, v in norm.items() if len(v) > 1}

    # locked = human-owned; informational so you can see what Claude must not touch
    locked = [str(p.relative_to(VAULT)) for p, fm, _ in notes if _is_locked(fm)]

    def section(title, items):
        print(f"\n{title}: {len(items)}")
        for it in items:
            print(f"  - {it}")

    print(f"audock doctor — {len(notes)} notes ({len(locked)} locked/human-owned)")
    section("broken links", [f"{src} -> [[{tgt}]]" for src, tgt in broken])
    section("notes citing a missing source", missing_src)
    section("orphan notes (no backlinks)", orphans)
    section("under-linked notes (< 2 links)", underlinked)
    section("duplicate-title candidates", [f"{k}: {', '.join(v)}" for k, v in dups.items()])
    section("tag variants (consider merging)", [f"{', '.join(v)}" for v in tag_variants.values()])
    section(f"stale notes (> {STALE_DAYS}d)", [f"{p} ({s})" for p, s in stale])
    if not (broken or missing_src or orphans or underlinked or dups or tag_variants or stale):
        print("\nall clear ✓")


# ---------- SQL-style bulk query / edit ----------
# A familiar SELECT/UPDATE/MERGE dialect over the vault: frontmatter keys are columns, plus
# pseudo-columns path/text/tags/backlinks/links. UPDATE & MERGE are dry-run unless --apply, never
# touch `locked`/#locked notes or (immutable) sources, bump `updated`, and log an audit line.
SQL_TABLES = {"notes": "note", "note": "note", "sources": "source", "source": "source",
              "maps": "moc", "moc": "moc", "mocs": "moc", "all": None}
SQL_PROTECTED = {"id", "type", "created", "hash", "captured", "locked"}


def _unquote(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        return s[1:-1]
    return s


def _split_outside_quotes(s, sep_re):
    """Split `s` on regex `sep_re`, but only where it occurs OUTSIDE single/double quotes —
    so `WHERE title = 'Rock AND Roll'` doesn't split on the AND inside the value."""
    out, last, i, q = [], 0, 0, None
    while i < len(s):
        c = s[i]
        if q:
            if c == q:
                q = None
            i += 1
            continue
        if c in "\"'":
            q = c
            i += 1
            continue
        m = sep_re.match(s, i)
        if m and m.end() > i:
            out.append(s[last:i])
            last = i = m.end()
            continue
        i += 1
    out.append(s[last:])
    return out


def _find_outside_quotes(s, rx):
    """First match of `rx` that starts outside single/double quotes, or None."""
    i, q = 0, None
    while i < len(s):
        c = s[i]
        if q:
            if c == q:
                q = None
        elif c in "\"'":
            q = c
        else:
            m = rx.match(s, i)
            if m:
                return m
        i += 1
    return None


_RE_KW_WHERE = re.compile(r"\s*\bWHERE\b\s*", re.I)
_RE_KW_ORDER = re.compile(r"\s*\bORDER\s+BY\b\s*", re.I)
_RE_KW_LIMIT = re.compile(r"\s*\bLIMIT\b\s*", re.I)
_RE_OR = re.compile(r"\s+OR\s+", re.I)
_RE_AND = re.compile(r"\s+AND\s+", re.I)
_RE_WHERE = re.compile(r"\s+WHERE\s+", re.I)


def _sql_rows(table):
    want = SQL_TABLES.get(table.lower())
    if table.lower() not in SQL_TABLES:
        sys.exit(f"sql: unknown table '{table}' (use notes|sources|maps|all)")
    rows = []
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        t = fm.get("type")
        if not t or t == "journal":
            continue
        if want and t != want:
            continue
        rows.append((p, fm, body))
    return rows


def _backlink_count(p, fm, graph):
    self_rel = str(p.relative_to(VAULT))
    return len({srel for k in _keys_of(p, fm) for _, _, srel in graph.get(k, [])
                if srel != self_rel})


def _field_value(field, p, fm, body, graph):
    f = field.lower()
    if f == "backlinks":
        return _backlink_count(p, fm, graph)
    if f in ("links", "outlinks"):
        return len(set(_links(body)))
    if f == "path":
        return str(p.relative_to(VAULT))
    if f in ("text", "body"):
        return body
    if f in ("tag", "tags"):
        return as_list(fm.get("tags"))
    if f in ("alias", "aliases"):
        return as_list(fm.get("aliases"))
    if f in ("source", "sources"):
        return as_list(fm.get("sources"))
    return fm.get(field, fm.get(f, ""))  # case-insensitive fall-through for real columns


def _like_re(pattern):
    # SQL LIKE: % => any run, _ => any char; everything else literal. (re.escape leaves % and _
    # untouched, so map them explicitly rather than post-processing an escaped string.)
    parts = [".*" if c == "%" else "." if c == "_" else re.escape(c) for c in pattern]
    return "^" + "".join(parts) + "$"


def _eval_cond(p, fm, body, graph, cond):
    field, op, target = cond
    if re.fullmatch(r"-?\d+(\.\d+)?", field) and op in ("=", "==", "!="):  # WHERE 1=1
        try:
            eq = float(field) == float(target)
        except (TypeError, ValueError):
            return False
        return eq if op != "!=" else not eq
    val = _field_value(field, p, fm, body, graph)
    if op == "ISNULL":
        return val in (None, "", [])
    if op == "ISNOTNULL":
        return val not in (None, "", [])
    if op in ("=", "==", "!=", "CONTAINS"):
        if isinstance(val, list):
            present = any(str(x).lower() == str(target).lower() for x in val)
        else:
            present = str(val).lower() == str(target).lower()
        return (not present) if op == "!=" else present
    if op in ("LIKE", "NOTLIKE"):
        hay = " ".join(val) if isinstance(val, list) else str(val)
        hit = bool(re.match(_like_re(str(target)), hay, re.I | re.S))
        return hit if op == "LIKE" else not hit
    if op == "IN":
        vals = [str(t).lower() for t in target]
        if isinstance(val, list):
            return any(str(x).lower() in vals for x in val)
        return str(val).lower() in vals
    if op in (">", "<", ">=", "<="):
        try:
            a, b = float(val), float(target)
        except (TypeError, ValueError):
            return False
        return {">": a > b, "<": a < b, ">=": a >= b, "<=": a <= b}[op]
    return False


def _parse_cond(c):
    c = c.strip()
    m = re.match(r"([\w-]+)\s+IS\s+NOT\s+NULL$", c, re.I)
    if m:
        return (m.group(1), "ISNOTNULL", None)
    m = re.match(r"([\w-]+)\s+IS\s+NULL$", c, re.I)
    if m:
        return (m.group(1), "ISNULL", None)
    m = re.match(r"([\w-]+)\s+(NOT\s+LIKE|LIKE|CONTAINS|IN)\s+(.+)$", c, re.I)
    if m:
        field, op, rhs = m.group(1), m.group(2).upper().replace(" ", ""), m.group(3).strip()
        if op == "IN":
            inner = rhs.strip()[1:-1] if rhs.startswith("(") else rhs
            return (field, "IN", [_unquote(x) for x in _split_inline_list(inner)])
        return (field, op, _unquote(rhs))
    m = re.match(r"([\w-]+)\s*(>=|<=|!=|=|>|<)\s*(.+)$", c)
    if m:
        return (m.group(1), m.group(2), _unquote(m.group(3)))
    sys.exit(f"sql: cannot parse condition: {c!r}")


def _parse_where(where):
    if not where:
        return None
    return [[_parse_cond(c) for c in _split_outside_quotes(part, _RE_AND)]
            for part in _split_outside_quotes(where, _RE_OR)]


def _match(p, fm, body, graph, conds):
    if conds is None:
        return True
    return any(all(_eval_cond(p, fm, body, graph, c) for c in ands) for ands in conds)


def _set_fm_field(raw, key, value_str):
    """Set one frontmatter key in place. Preserves a UTF-8 BOM and CRLF line endings, and
    removes the old value's continuation lines (indented, or an unindented `- item` block list)
    so the result stays valid YAML. Returns `raw` unchanged if there is no frontmatter."""
    bom = "﻿" if raw.startswith("﻿") else ""
    body = raw[len(bom):]
    lines = body.split("\n")
    if not lines or lines[0].strip() != "---":
        return raw
    close = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if close is None:
        return raw
    cr = "\r" if lines[0].endswith("\r") else ""
    new_line = f"{key}: {value_str}{cr}"
    pat = re.compile(rf"^{re.escape(key)}\s*:(.*)$")
    for i in range(1, close):
        m = pat.match(lines[i].rstrip("\r"))
        if m:
            empty_val = m.group(1).strip() == ""
            j = i + 1
            while j < close:
                ln = lines[j].rstrip("\r")
                if not ln.strip():
                    break
                if ln[:1] in (" ", "\t") or (empty_val and re.match(r"^-(\s|$)", ln)):
                    j += 1
                    continue
                break
            del lines[i + 1:j]
            lines[i] = new_line
            return bom + "\n".join(lines)
    lines.insert(close, new_line)
    return bom + "\n".join(lines)


def _append_log(raw, line):
    lines = raw.split("\n")
    for i, ln in enumerate(lines):
        if ln.strip().lower() == "## log":
            lines.insert(i + 1, line)
            return "\n".join(lines)
    return raw.rstrip() + f"\n\n## Log\n{line}\n"


def _is_locked(fm):
    return str(fm.get("locked", "")).lower() == "true" or "locked" in as_list(fm.get("tags"))


def _sql_select(stmt, args):
    m = re.match(r"SELECT\s+(.+?)\s+FROM\s+(\w+)(.*)$", stmt, re.I | re.S)
    if not m:
        sys.exit("sql: SELECT <cols> FROM <table> [WHERE ...] [ORDER BY col [DESC]] [LIMIT n]")
    cols_s, table, rest = m.group(1), m.group(2), m.group(3)
    # carve WHERE / ORDER BY / LIMIT only where the keywords sit OUTSIDE quotes, so a value
    # like 'Limit of embeddings' or '... order by date' can't truncate the condition
    found = []
    for name, rx in (("where", _RE_KW_WHERE), ("order", _RE_KW_ORDER), ("limit", _RE_KW_LIMIT)):
        km = _find_outside_quotes(rest, rx)
        if km:
            found.append((km.start(), name, km))
    found.sort(key=lambda x: x[0])
    if found and rest[:found[0][0]].strip():
        sys.exit(f"sql: unexpected text after table: {rest[:found[0][0]].strip()!r}")
    if not found and rest.strip():
        sys.exit(f"sql: unexpected text after table: {rest.strip()!r}")
    part = {}
    for idx, (_, name, km) in enumerate(found):
        end = found[idx + 1][0] if idx + 1 < len(found) else len(rest)
        part[name] = rest[km.end():end].strip()
    om = re.fullmatch(r"([\w-]+)(?:\s+(DESC|ASC))?", part.get("order", ""), re.I) \
        if "order" in part else None
    if "order" in part and not om:
        sys.exit(f"sql: bad ORDER BY: {part['order']!r}")
    lm = re.fullmatch(r"(\d+)", part.get("limit", "")) if "limit" in part else None
    if "limit" in part and not lm:
        sys.exit(f"sql: bad LIMIT: {part['limit']!r}")
    conds = _parse_where(part.get("where"))
    cols = (["path", "title", "status", "tags"] if cols_s.strip() == "*"
            else [c.strip() for c in _split_inline_list(cols_s)])
    graph = _link_graph()
    out = []
    for p, fm, body in _sql_rows(table):
        if _match(p, fm, body, graph, conds):
            out.append((p, fm, body))
    if om:
        key = om.group(1)
        numeric = key.lower() in ("backlinks", "links", "outlinks")

        def _ordk(r):
            v = _field_value(key, r[0], r[1], r[2], graph)
            if numeric:
                return float(v) if str(v).replace(".", "", 1).isdigit() else 0.0
            return str(v)
        out.sort(key=_ordk, reverse=(om.group(2) or "").upper() == "DESC")
    if lm:
        out = out[: int(lm.group(1))]
    print(" | ".join(cols))
    for p, fm, body in out:
        vals = []
        for c in cols:
            v = _field_value(c, p, fm, body, graph)
            vals.append(", ".join(map(str, v)) if isinstance(v, list) else str(v))
        print(" | ".join(vals))
    print(f"-- {len(out)} row(s)")


def _parse_assignments(set_s):
    assigns = []
    for a in _split_inline_list(set_s):
        m = re.match(r"(\w+)\s*=\s*(.+)$", a.strip(), re.S)
        if not m:
            sys.exit(f"sql: cannot parse assignment: {a!r}")
        field, rhs = m.group(1), m.group(2).strip()
        if field.lower() in SQL_PROTECTED:
            sys.exit(f"sql: field '{field}' is protected and cannot be set")
        if rhs.upper() == "NULL":
            assigns.append((field, "clear", None))
        elif re.match(rf"{re.escape(field)}\s*\+\s*", rhs):
            assigns.append((field, "list_add", _unquote(rhs.split("+", 1)[1])))
        elif re.match(rf"{re.escape(field)}\s*-\s*", rhs):
            assigns.append((field, "list_remove", _unquote(rhs.split("-", 1)[1])))
        else:
            assigns.append((field, "set", _unquote(rhs)))
    return assigns


def _sql_update(stmt, args):
    m = re.match(r"UPDATE\s+(\w+)\s+SET\s+(.+)$", stmt, re.I | re.S)
    if not m:
        sys.exit("sql: UPDATE <table> SET <a=b,...> WHERE <conds>  (use WHERE 1=1 for all)")
    table = m.group(1)
    segs = _split_outside_quotes(m.group(2), _RE_WHERE)  # split SET/WHERE outside quotes
    if len(segs) < 2:
        sys.exit("sql: UPDATE requires a WHERE clause (use WHERE 1=1 to match all)")
    set_s, where = segs[0], " WHERE ".join(segs[1:])
    assigns = _parse_assignments(set_s)
    conds = _parse_where(where)
    graph = _link_graph()
    changed, locked_skip = [], []
    for p, fm, body in _sql_rows(table):
        if fm.get("type") == "source":
            continue  # sources are immutable
        if not _match(p, fm, body, graph, conds):
            continue
        if _is_locked(fm):
            locked_skip.append(str(p.relative_to(VAULT)))
            continue
        raw = read(p)
        new = raw
        notes = []
        for field, kind, arg in assigns:
            if kind == "set":
                new = _set_fm_field(new, field, arg)
                notes.append(f"{field}={arg!r}")
            elif kind == "clear":
                new = _set_fm_field(new, field, "")
                notes.append(f"{field}=NULL")
            else:  # list_add / list_remove
                cur = as_list(parse_frontmatter(new)[0].get(field))
                if kind == "list_add" and arg not in cur:
                    cur.append(arg)
                elif kind == "list_remove":
                    cur = [x for x in cur if x != arg]
                new = _set_fm_field(new, field, "[" + ", ".join(cur) + "]")
                notes.append(f"{field}{'+' if kind == 'list_add' else '-'}={arg!r}")
        if new != raw:
            new = _set_fm_field(new, "updated", today())
            if fm.get("type") == "note":
                new = _append_log(new, f"- {today()} — sql: {', '.join(notes)}")
            changed.append(str(p.relative_to(VAULT)))
            if args.apply:
                p.write_text(new, encoding="utf-8")
    verb = "updated" if args.apply else "would update (dry-run)"
    print(f"{verb}: {len(changed)} file(s)")
    for c in changed:
        print(f"  ~ {c}")
    if locked_skip:
        print(f"skipped {len(locked_skip)} locked/human-owned: {', '.join(locked_skip)}")
    if changed and not args.apply:
        print("\n(dry-run — re-run with --apply to write, then git commit)")


def _rewrite_links(raw, drop_keys, keep_id):
    def repl(m):
        inner = m.group(1)
        head = re.split(r"[|#]", inner)[0]
        if head.strip().lower() in drop_keys:
            return f"[[{keep_id}{inner[len(head):]}]]"
        return m.group(0)
    return re.sub(r"\[\[([^\]]+)\]\]", repl, raw)


def _sql_merge(stmt, args):
    m = re.match(r"MERGE\s+(.+?)\s+INTO\s+(.+)$", stmt, re.I)
    if not m:
        sys.exit("sql: MERGE '<drop>' INTO '<keep>'")
    dhit, khit = _resolve(_unquote(m.group(1))), _resolve(_unquote(m.group(2)))
    if not dhit:
        sys.exit(f"sql: merge source not found: {m.group(1)}")
    if not khit:
        sys.exit(f"sql: merge target not found: {m.group(2)}")
    dp, dfm, dbody = dhit
    kp, kfm, kbody = khit
    if dp == kp:
        sys.exit("sql: cannot merge a note into itself")
    if dfm.get("type") not in ("note", "moc") or kfm.get("type") not in ("note", "moc"):
        sys.exit("sql: MERGE only operates on notes/MOCs (sources are immutable)")
    if _is_locked(dfm) or _is_locked(kfm):
        sys.exit("sql: refusing to merge a locked/human-owned note")
    keep_id = kfm.get("id") or kp.stem
    drop_keys = _keys_of(dp, dfm)
    rewired = []
    for p in md_files():
        fm, _ = parse_frontmatter(read(p))
        if fm.get("type") in (None, "journal", "source") or p == dp or _is_locked(fm):
            continue  # never rewrite verbatim sources or human-owned notes
        raw = read(p)
        new = _rewrite_links(raw, drop_keys, keep_id)
        if new != raw:
            rewired.append(str(p.relative_to(VAULT)))
            if args.apply:
                p.write_text(new, encoding="utf-8")
    # keep: alias of the dropped title + a log line
    kraw = read(kp)
    aliases = as_list(kfm.get("aliases"))
    if dfm.get("title") and dfm.get("title") not in aliases:
        aliases.append(dfm.get("title"))
    kraw = _set_fm_field(kraw, "aliases", "[" + ", ".join(aliases) + "]")
    kraw = _append_log(kraw, f"- {today()} — sql: merged [[{dfm.get('id')}]] into this note")
    # drop: tombstone pointing at keep, superseded (history preserved, never deleted)
    draw = read(dp)
    draw = _set_fm_field(draw, "status", "superseded")
    draw = _set_fm_field(draw, "superseded_by", f'"[[{keep_id}]]"')
    draw = _append_log(draw, f"- {today()} — sql: merged into [[{keep_id}]]")
    if args.apply:
        kp.write_text(kraw, encoding="utf-8")
        dp.write_text(draw, encoding="utf-8")
    verb = "merged" if args.apply else "would merge (dry-run)"
    print(f"{verb}: {dfm.get('title')} [[{dfm.get('id')}]] -> {kfm.get('title')} [[{keep_id}]]")
    print(f"  links rewired in {len(rewired)} file(s); drop note superseded; title kept as alias")
    if not args.apply:
        print("\n(dry-run — re-run with --apply to write, then git commit)")


def cmd_sql(args):
    stmt = args.statement.strip().rstrip(";")
    kw = (stmt.split(None, 1)[0] if stmt else "").upper()
    if kw == "SELECT":
        _sql_select(stmt, args)
    elif kw == "UPDATE":
        _sql_update(stmt, args)
    elif kw == "MERGE":
        _sql_merge(stmt, args)
    else:
        sys.exit("sql: statement must start with SELECT, UPDATE, or MERGE")


