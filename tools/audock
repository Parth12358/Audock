def cmd_init(args):
    import json
    import shutil
    dry = getattr(args, "dry_run", False)
    target = Path(args.path or ".").resolve()
    existing = (target / ".obsidian").is_dir()
    created, skipped = [], []

    if not dry:
        for d in ["sources/conversations", "sources/web", "sources/code", "sources/manual",
                  "notes", "maps", "journal", "templates", "tools", "inbox",
                  ".claude/skills/audock", ".obsidian"]:
            (target / d).mkdir(parents=True, exist_ok=True)

    files = {
        "CLAUDE.md": EMB_CLAUDE, "index.md": EMB_INDEX, "tags.md": EMB_TAGS,
        ".gitignore": EMB_GITIGNORE,
        "templates/note.md": EMBEDDED_TEMPLATES["note"],
        "templates/source.md": EMBEDDED_TEMPLATES["source"],
        "templates/moc.md": EMBEDDED_TEMPLATES["moc"],
        ".claude/skills/audock/SKILL.md": EMB_SKILL,
        ".obsidian/app.json": EMB_APP,
    }
    for rel, content in files.items():
        p = target / rel
        if p.exists():
            skipped.append(rel)
        else:
            if not dry:
                p.parent.mkdir(parents=True, exist_ok=True)
                p.write_text(content, encoding="utf-8")
            created.append(rel)

    # graph.json — merge our color groups into an existing graph config, else write ours
    gp = target / ".obsidian" / "graph.json"
    if gp.exists():
        try:
            g = json.loads(read(gp))
        except Exception:  # noqa: BLE001
            g = None
        if not isinstance(g, dict):  # unreadable: never overwrite the user's graph settings
            skipped.append(".obsidian/graph.json (unreadable — left untouched)")
        else:
            groups = [x for x in (g.get("colorGroups") or []) if isinstance(x, dict)]
            have = {grp.get("query") for grp in groups}
            added = [grp for grp in GRAPH_GROUPS if grp["query"] not in have]
            if added and not dry:
                g["colorGroups"] = groups + added
                gp.write_text(json.dumps(g, indent=2), encoding="utf-8")
            (created if added else skipped).append(
                f".obsidian/graph.json (+{len(added)} color groups, existing kept)")
    else:
        if not dry:
            (target / ".obsidian").mkdir(parents=True, exist_ok=True)
            gp.write_text(json.dumps(EMB_GRAPH, indent=2), encoding="utf-8")
        created.append(".obsidian/graph.json")

    # community-plugins.json — ensure recommended plugins are listed, preserving existing ones:
    # dataview (tables), omnisearch (fuzzy search), smart-connections (local semantic search —
    # the bolt-on for the embeddings Audock defers).
    want_plugins = ["dataview", "omnisearch", "smart-connections"]
    cp = target / ".obsidian" / "community-plugins.json"
    if cp.exists():
        try:
            lst = json.loads(read(cp))
        except Exception:  # noqa: BLE001
            lst = None
        if not isinstance(lst, list):  # unreadable or unexpected shape: never overwrite it
            skipped.append(".obsidian/community-plugins.json (unreadable — left untouched; "
                           "add dataview/omnisearch/smart-connections by hand)")
        else:
            added_p = [x for x in want_plugins if x not in lst]
            if added_p and not dry:
                cp.write_text(json.dumps(lst + added_p), encoding="utf-8")
            (created if added_p else skipped).append(
                f".obsidian/community-plugins.json (+{len(added_p)}, existing kept)")
    else:
        if not dry:
            cp.write_text(json.dumps(want_plugins), encoding="utf-8")
        created.append(".obsidian/community-plugins.json")

    # tools/audock — copy the script in when running from the repo (self-contained vault)
    taudock = target / "tools" / "audock"
    src = _src_repo()
    if taudock.exists():
        skipped.append("tools/audock")
    elif src and (src / "tools" / "audock").resolve() != taudock.resolve():
        if not dry:
            taudock.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src / "tools" / "audock", taudock)
            os.chmod(taudock, 0o755)
        created.append("tools/audock")
    else:
        skipped.append("tools/audock (use the installed `audock` binary, or copy the script in)")

    head = "[DRY RUN] would initialize" if dry else "Audock initialized in"
    where = " (existing Obsidian vault detected — your files/config are preserved)" if existing else ""
    print(f"{head} {target}{where}")
    for c in created:
        print(f"  {'~' if dry else '+'} {c}")
    for s in skipped:
        print(f"  = {s} (kept)")
    if dry:
        print("\n(nothing written — re-run without --dry-run to apply)")
        return
    print("\nNext:")
    print("  1) git init && git add -A && git commit -m 'add Audock'   (if not a repo yet)")
    print("  2) audock reindex && audock doctor")
    print("  3) In Obsidian: enable the Dataview community plugin.")
    if existing:
        print("  4) Your existing notes are untouched. To fold one into Audock, add frontmatter")
        print("     (type: note, id, status); mark human-owned notes `locked: true` so I never edit them.")


def main():
    ap = argparse.ArgumentParser(prog="audock", description="Audock vault librarian")
    ap.add_argument("--vault", help="vault root (else $AUDOCK_VAULT or nearest ancestor)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_new = sub.add_parser("new", help="scaffold a file from a template")
    p_new.add_argument("kind", choices=["note", "source", "moc"])
    p_new.add_argument("title")
    p_new.add_argument("--force", action="store_true")
    p_new.set_defaults(func=cmd_new)

    p_ing = sub.add_parser("ingest", help="capture raw material into sources/")
