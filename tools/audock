#!/usr/bin/env python3
"""audock — the Audock vault librarian CLI.

Zero required dependencies. Uses ripgrep for fast search if present, else falls back to a
pure-Python scan. The vault root is found via --vault, then $AUDOCK_VAULT, then the nearest
ancestor of the CWD containing notes/ & sources/, then this script's parent dir — so the
in-repo script and a released standalone binary both work.

Commands:
  init [path] [--dry-run]                          scaffold Audock into a new/existing vault
  new note|source|moc "Title"                      scaffold a file from a template
  ingest <file|url|-> --type KIND [--title ..] [--ref ..]   capture raw material into sources/
  context "question" [--tag T] [--k N] [--all]     bounded answer pack (cheapest query)
  query "text" [--tag T] [--type T] [--since DATE] [--all] [--json]   ranked search
  similar "title"                                  top-k similar notes (dedup gate)
  show <id> [--body | --raw]                       one item; --raw = verbatim/lossless
  log "message"                                    append a line to today's journal
  reindex                                          rebuild tags.md + index.md maps list
  doctor                                           hygiene report (links/orphans/dups/...)
"""
import argparse
import hashlib
import os
import re
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone, date, timedelta
from pathlib import Path

VAULT = None  # resolved at startup by _resolve_vault()
SKIP_DIRS = {".git", ".obsidian", "templates", ".trash", "__pycache__", "inbox"}


def _resolve_vault(explicit=None):
    """Find the vault root so a released standalone binary works from anywhere:
    --vault flag > $AUDOCK_VAULT > nearest ancestor of CWD containing notes/ & sources/
    > this script's parent dir (the in-repo `<vault>/tools/audock` layout)."""
    if explicit:
        return Path(explicit).resolve()
    env = os.environ.get("AUDOCK_VAULT")
    if env:
        return Path(env).resolve()
    cur = Path.cwd().resolve()
    for d in [cur, *cur.parents]:
        if (d / "notes").is_dir() and (d / "sources").is_dir():
            return d
    try:
        return Path(__file__).resolve().parent.parent
    except NameError:  # frozen binary with no real __file__
        return cur
KIND_TO_DIR = {
    "conversation": "conversations",
    "code": "code",
    "web": "web",
    "manual": "manual",
}
STALE_DAYS = 180


# ---------- small utilities ----------

def slugify(text):
    text = text.strip().lower()
    text = re.sub(r"[^\w\s-]", "", text)
    text = re.sub(r"[\s_]+", "-", text)
    text = re.sub(r"-+", "-", text).strip("-")
    return text or "untitled"


def today():
    return date.today().isoformat()


def utc_stamp():
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")


def utc_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def md_files(root=None):
    root = root or VAULT
    for p in sorted(root.rglob("*.md")):
        if any(part in SKIP_DIRS for part in p.relative_to(VAULT).parts):
            continue
        yield p


def read(p):
    return p.read_text(encoding="utf-8", errors="replace")


# ---------- minimal frontmatter parser (no PyYAML needed) ----------

def _strip_q(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
        return v[1:-1]
    return v


def _split_inline_list(inner):
    out, buf, depth, q = [], "", 0, None
    for ch in inner:
        if q:
            buf += ch
            if ch == q:
                q = None
        elif ch in "\"'":
            q = ch
            buf += ch
        elif ch in "[":
            depth += 1
            buf += ch
        elif ch in "]":
            depth -= 1
            buf += ch
        elif ch == "," and depth == 0:
            out.append(buf)
            buf = ""
        else:
            buf += ch
    if buf.strip():
        out.append(buf)
    return [_strip_q(x) for x in out]


def parse_frontmatter(text):
    """Return (dict, body). Tolerant of scalars, inline [lists], and block - lists."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return {}, text
    fm_lines = lines[1:end]
    body = "\n".join(lines[end + 1:])
    data = {}
    i, n = 0, len(fm_lines)
    while i < n:
        line = fm_lines[i]
        if not line.strip() or line.strip().startswith("#"):
            i += 1
            continue
        m = re.match(r"^([A-Za-z0-9_\-]+):\s*(.*)$", line)
        if not m:
            i += 1
            continue
        key, val = m.group(1).strip(), m.group(2).strip()
        if val == "":
            items, j = [], i + 1
            while j < n and re.match(r"^\s*-\s+", fm_lines[j]):
                items.append(_strip_q(re.sub(r"^\s*-\s+", "", fm_lines[j]).strip()))
                j += 1
            if items:
                data[key] = items
                i = j
                continue
            data[key] = ""
            i += 1
            continue
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            data[key] = _split_inline_list(inner) if inner else []
        else:
            data[key] = _strip_q(val)
        i += 1
    return data, body


def as_list(v):
    if v is None or v == "":
        return []
    return v if isinstance(v, list) else [v]


# ---------- template instantiation ----------

# Embedded fallbacks so a standalone binary works without the vault's templates/ dir.
# When templates/<name>.md exists in the vault it takes precedence (Obsidian-editable).
EMBEDDED_TEMPLATES = {
    "note": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: note\ntags: []\nsummary: \n"
        "created: __DATE__\nupdated: __DATE__\naliases: []\nsources: []\n"
        "status: draft\nsuperseded_by: \nlocked: false\n---\n\n# __TITLE__\n\n"
        "<!-- One concept per note. Distilled, not verbatim. Link liberally with [[other-note]]. -->\n"
        "<!-- summary: = one line — what this note claims + where it came from (boosts retrieval). -->\n"
        "<!-- When superseded, set status: superseded and superseded_by: \"[[new-note]]\". -->\n"
        "<!-- locked: true => human-owned; Claude must NOT edit, supersede, move, or delete. -->\n\n"
        "## Log\n- __DATE__ — created\n"
    ),
    "source": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: source\norigin: __ORIGIN__\n"
        "origin_ref: __ORIGIN_REF__\ncaptured: __TS__\nhash: __HASH__\n"
        "distilled_into: []\n---\n__BODY__\n"
    ),
    "moc": (
        "---\nid: __ID__\ntitle: __TITLE__\ntype: moc\ntags: [moc]\ncreated: __DATE__\n"
        "updated: __DATE__\naliases: []\nstatus: stable\n---\n\n# __TITLE__\n\n"
        "## Key notes\n<!-- Curated [[wikilinks]] — the canonical entry points. -->\n\n"
        "## All notes in this domain\n```dataview\nTABLE updated, status\nFROM #__SLUG__\n"
        "WHERE type = \"note\"\nSORT updated DESC\n```\n"
    ),
}


def fill_template(name, mapping):
    f = VAULT / "templates" / f"{name}.md"
    tpl = read(f) if f.exists() else EMBEDDED_TEMPLATES[name]
    for k, v in mapping.items():
        tpl = tpl.replace(k, v)
    return tpl


def write_new(path, content, force=False):
    if path.exists() and not force:
        sys.exit(f"error: {path.relative_to(VAULT)} already exists (use a different title)")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    return path


# ---------- daily activity log ----------

def _journal(action, detail):
    """Append a dated line to journal/YYYY-MM-DD.md (an Obsidian daily note). Records what
    the librarian did, so there's a human-browsable activity trail. type: journal keeps these
    out of knowledge queries."""
    day = today()
    jdir = VAULT / "journal"
    jdir.mkdir(parents=True, exist_ok=True)
    f = jdir / f"{day}.md"
    if not f.exists():
        f.write_text(
            f"---\nid: {day}-journal\ntitle: Journal {day}\ntype: journal\ncreated: {day}\n"
            f"---\n\n# Journal {day}\n\n",
            encoding="utf-8",
        )
    with f.open("a", encoding="utf-8") as fh:
        fh.write(f"- {datetime.now().strftime('%H:%M')} — {action}: {detail}\n")


# ---------- commands ----------

def cmd_log(args):
    _journal("note", args.message)
    print(f"logged to journal/{today()}.md")


def cmd_new(args):
    title = args.title
    slug = slugify(title)
    d = today()
    if args.kind == "note":
        content = fill_template("note", {
            "__ID__": f"{d.replace('-', '')}-{slug}",
            "__TITLE__": title,
            "__DATE__": d,
        })
        path = write_new(VAULT / "notes" / f"{slug}.md", content, args.force)
    elif args.kind == "moc":
        content = fill_template("moc", {
            "__ID__": f"{d.replace('-', '')}-{slug}",
            "__TITLE__": title,
            "__DATE__": d,
            "__SLUG__": slug,
        })
        path = write_new(VAULT / "maps" / f"{slug}.md", content, args.force)
    elif args.kind == "source":
        ts = utc_stamp()
        content = fill_template("source", {
            "__ID__": f"{ts}-{slug}",
            "__TITLE__": title,
            "__ORIGIN__": "manual",
            "__ORIGIN_REF__": "manual",
            "__TS__": utc_iso(),
            "__HASH__": "sha256:(none)",
            "__BODY__": "",
        })
        path = write_new(VAULT / "sources" / "manual" / f"{ts}-{slug}.md", content, args.force)
    print(f"created {path.relative_to(VAULT)}")
    _journal(f"new {args.kind}", f"{title} ({path.relative_to(VAULT)})")


def _load_body(src, kind):
    """Return (body_text, origin_ref) for ingest input."""
    if src == "-":
        return sys.stdin.read(), "stdin"
    if re.match(r"^https?://", src):
        try:
            req = urllib.request.Request(src, headers={"User-Agent": "audock/1.0"})
            with urllib.request.urlopen(req, timeout=20) as r:
                raw = r.read().decode("utf-8", errors="replace")
            return raw, src
        except Exception as e:  # noqa: BLE001 — capture reference even if fetch fails
            return f"(could not fetch {src}: {e})", src
    p = Path(src)
    if p.exists():
        return p.read_text(encoding="utf-8", errors="replace"), str(p)
    sys.exit(f"error: no such file/url: {src}")


def cmd_ingest(args):
    kind = args.type
    if kind not in KIND_TO_DIR:
        sys.exit(f"error: --type must be one of {', '.join(KIND_TO_DIR)}")
    body, ref = _load_body(args.source, kind)
    ref = args.ref or ref
    title = args.title or (Path(ref).name if ref not in ("stdin",) else f"{kind} capture")
    slug = slugify(title)
    ts = utc_stamp()
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
    source_id = f"{ts}-{slug}"

    # dedup by hash across existing sources
    for existing in (VAULT / "sources").rglob("*.md"):
        fm, _ = parse_frontmatter(read(existing))
        if str(fm.get("hash", "")).endswith(digest):
            print(f"duplicate: identical content already captured at "
                  f"{existing.relative_to(VAULT)} ([[{fm.get('id')}]])")
            print("skipping re-capture. Distill from the existing source.")
            return

    content = fill_template("source", {
        "__ID__": source_id,
        "__TITLE__": title,
        "__ORIGIN__": kind,
        "__ORIGIN_REF__": ref,
        "__TS__": utc_iso(),
        "__HASH__": f"sha256:{digest}",
        "__BODY__": body,  # stored verbatim — the body below the frontmatter is the ground truth
    })
    out = write_new(VAULT / "sources" / KIND_TO_DIR[kind] / f"{source_id}.md", content, args.force)
    print(f"captured {out.relative_to(VAULT)}")
    print(f"source id: {source_id}")
    _journal(f"ingest({kind})", f"{title} ([[{source_id}]])")
    print(f"next: check for an existing note first  →  tools/audock similar \"{title}\"")
    print("then distill: tools/audock new note \"<Concept>\"  and set "
          f"sources: [\"[[{source_id}]]\"]")


# Tiny stopword list so natural-language questions tokenize to meaningful terms.
STOPWORDS = {
    "a", "an", "the", "of", "to", "in", "on", "for", "and", "or", "is", "are", "be", "do",
    "does", "how", "what", "why", "when", "which", "who", "that", "this", "with", "as", "by",
    "it", "its", "from", "at", "we", "i", "you", "can", "should", "would", "about", "into",
    "was", "were", "has", "have", "had", "will", "me", "my",
}


def _tokens(term):
    """Split a query/question into meaningful search tokens (keeps `domain/ml` style tags)."""
    out = []
    for t in re.findall(r"[a-z0-9][a-z0-9/_-]*", term.lower()):
        t = t.strip("/-_")
        if len(t) >= 2 and t not in STOPWORDS:
            out.append(t)
    return out


def _first_line(body):
    for line in body.split("\n"):
        ls = line.strip()
        if ls and not ls.startswith(("#", "<!--", "---", "```")):
            return ls
    return ""


def _score(term, fm, body, path):
    toks = _tokens(term)
    if not toks:  # tag/type-only listing: neutral match so filters still return rows
        return 1, _first_line(body)[:160]
    title = str(fm.get("title", "")).lower()
    summary = str(fm.get("summary", "")).lower()
    aliases = " ".join(as_list(fm.get("aliases"))).lower()
    tags = " ".join(as_list(fm.get("tags"))).lower()
    body_l = body.lower()
    name = path.name.lower()

    def hits(token, text):  # word-boundary (prefix) match: `embedding` hits `embeddings`,
        return len(re.findall(r"\b" + re.escape(token), text))  # but `thing` misses `everything`

    score = 0
    for t in toks:
        if hits(t, title):
            score += 10
        if hits(t, summary):  # contextual-prefix lever: the authored one-liner ranks high
            score += 8
        if hits(t, aliases):
            score += 6
        if hits(t, tags):
            score += 4
        score += hits(t, body_l)
        if hits(t, name):
            score += 2
    phrase = term.strip().lower()
    if len(phrase) >= 4 and phrase in body_l:  # exact-phrase bonus keeps precision
        score += 5
    snippet = ""
    for line in body.split("\n"):
        ls = line.strip()
        if ls and not ls.startswith(("---", "<!--")) and any(hits(t, ls.lower()) for t in toks):
            snippet = ls
            break
    return score, (snippet or _first_line(body))[:160]


def _rg_candidates(term):
    toks = _tokens(term)
    if not toks:
        return None
    cmd = ["rg", "-l", "-i", "--glob", "*.md"]
    for t in toks:  # multiple -e => OR semantics (recall across all tokens)
        cmd += ["-e", re.escape(t)]
    cmd.append(str(VAULT))
    try:
        out = subprocess.run(cmd, capture_output=True, text=True)
        if out.returncode in (0, 1):
            files = [Path(p) for p in out.stdout.splitlines() if p]
            return [p for p in files if not any(part in SKIP_DIRS
                    for part in p.relative_to(VAULT).parts)]
    except FileNotFoundError:
        return None
    return None


def _search(term, tag=None, type_=None, since=None, include_superseded=False):
    """Rank vault files against `term` with optional filters. Returns list of dicts.
    Journal entries are always excluded (activity log, not knowledge); superseded notes are
    excluded unless include_superseded — so stale/contradicted notes don't surface by default."""
    candidates = _rg_candidates(term)
    files = candidates if candidates is not None else list(md_files())
    results = []
    for p in files:
        fm, body = parse_frontmatter(read(p))
        if not fm.get("type"):  # skip operational docs (CLAUDE.md, README.md); not knowledge
            continue
        if str(fm.get("type", "")) == "journal":
            continue
        if not include_superseded and str(fm.get("status", "")).lower() == "superseded":
            continue
        if type_ and str(fm.get("type", "")) != type_:
            continue
        if tag and tag not in as_list(fm.get("tags")):
            continue
        if since:
            stamp = str(fm.get("updated") or fm.get("created")
                        or fm.get("captured") or "")[:10]
            if stamp and stamp < since:
                continue
        score, snippet = _score(term, fm, body, p)
        if score <= 0:
            continue
        results.append({
            "path": str(p.relative_to(VAULT)),
            "id": fm.get("id", ""),
            "title": fm.get("title", ""),
            "type": fm.get("type", ""),
            "tags": as_list(fm.get("tags")),
            "score": score,
            "snippet": snippet,
        })
    results.sort(key=lambda r: (-r["score"], r["path"]))
    return results


def _resolve(ident):
    """Resolve an id / title / alias / filename-stem to (path, fm, body) or None."""
    t = ident.strip().lower()
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        keys = {str(fm.get("id", "")).lower(), str(fm.get("title", "")).lower(), p.stem.lower()}
        keys |= {a.lower() for a in as_list(fm.get("aliases"))}
        if t in keys:
            return p, fm, body
    return None


def _compact_body(body):
    """Comment-stripped, trimmed body — the minimum tokens needed to convey the note."""
    return _COMMENT_RE.sub("", body).strip()


def cmd_show(args):
    """Print a single note/source cheaply: minimal frontmatter + comment-stripped body.
    --raw gives the exact file (use for lossless drill-down into a source capture)."""
    hit = _resolve(args.id)
    if not hit:
        sys.exit(f"not found: {args.id}")
    p, fm, body = hit
    if args.raw:
        sys.stdout.write(read(p))
        return
    clean = _compact_body(body)
    if args.body:
        print(clean)
        return
    for k in ("id", "title", "type", "tags", "summary", "sources", "status",
              "superseded_by", "updated"):
        v = fm.get(k)
        if v:
            print(f"{k}: {', '.join(v) if isinstance(v, list) else v}")
    print()
    print(clean)


def cmd_context(args):
    """One call → a bounded, deduped, comment-stripped answer pack for a question.
    This is the cheapest way to answer: no frontmatter noise, no whole-file reads,
    size-capped, with explicit note of anything omitted (never a silent cap)."""
    sup = getattr(args, "all", False)
    results = _search(args.question, tag=args.tag, type_="note", since=args.since,
                      include_superseded=sup)
    from_sources = False
    if not results:
        # Fall back to raw sources: the vault may hold the answer undistilled. Returning
        # "nothing" when a source matches would be a correctness (recall) failure.
        results = _search(args.question, tag=args.tag, type_="source", since=args.since)
        from_sources = True
    if not results:
        print("no matches — the vault has nothing on this. Consider INGEST.")
        return
    if from_sources:
        print("[no distilled note yet — showing raw source(s); consider distilling]\n")
    blocks, used, shown = [], 0, 0
    for r in results[: args.k]:
        fm, body = parse_frontmatter(read(VAULT / r["path"]))
        clean = _compact_body(body)
        prov = as_list(fm.get("sources"))
        tag = "  (raw source)" if from_sources else ""
        header = f"### {fm.get('title', r['id'])}  [[{fm.get('id', '')}]]{tag}"
        if fm.get("summary"):
            header += f"\n_{fm.get('summary')}_"
        if prov:
            header += f"\nsources: {', '.join(prov)}"
        block = f"{header}\n{clean}\n"
        if shown > 0 and used + len(block) > args.max_bytes:
            break
        blocks.append(block)
        used += len(block)
        shown += 1
    print("\n".join(blocks))
    omitted = len(results) - shown
    if omitted > 0:
        print(f"\n[{omitted} more match(es) not shown (size/-k cap). "
              f"Full list: audock query \"{args.question}\"]")
    print("[For verbatim quotes/numbers/code, drill to a source: audock show <source-id> --raw]")


def cmd_similar(args):
    """Top-k existing NOTES similar to a title/text — run before distilling so you can
    choose ADD / UPDATE / SUPERSEDE / NOOP instead of creating a near-duplicate."""
    results = _search(args.text, type_="note", include_superseded=True)
    if not results:
        print("no similar notes — safe to ADD a new note")
        return
    print("most similar existing notes (consider UPDATE/SUPERSEDE before adding a duplicate):")
    for r in results[: args.k]:
        print(f"[{r['score']:>3}] {r['title']}  [[{r['id']}]]  ({r['path']})")


def cmd_query(args):
    results = _search(args.text or "", tag=args.tag, type_=args.type, since=args.since,
                      include_superseded=getattr(args, "all", False))
    if args.json:
        import json
        print(json.dumps(results, indent=2))
        return
    if not results:
        print("no matches")
        return
    for r in results[: args.limit]:
        print(f"[{r['score']:>3}] {r['title']}  ({r['path']})")
        if r["tags"]:
            print(f"      tags: {', '.join(r['tags'])}")
        if r["snippet"]:
            print(f"      {r['snippet']}")
    if len(results) > args.limit:
        print(f"... {len(results) - args.limit} more (use --limit)")


def _replace_block(text, begin, end, new_inner):
    pat = re.compile(re.escape(begin) + r".*?" + re.escape(end), re.DOTALL)
    repl = f"{begin}\n{new_inner}\n{end}"
    if pat.search(text):
        return pat.sub(lambda _: repl, text)
    return text  # markers missing; leave untouched


def cmd_reindex(args):
    # 1) tags.md static block
    tag_map = {}
    for p in md_files(VAULT / "notes"):
        fm, _ = parse_frontmatter(read(p))
        for tag in as_list(fm.get("tags")):
            tag_map.setdefault(tag, []).append(fm.get("id") or p.stem)
    lines = []
    for tag in sorted(tag_map):
        ids = sorted(tag_map[tag])
        links = " ".join(f"[[{i}]]" for i in ids)
        lines.append(f"- `#{tag}` ({len(ids)}): {links}")
    inner = "\n".join(lines) if lines else "- (no tags yet)"
    tags_path = VAULT / "tags.md"
    tags_path.write_text(
        _replace_block(read(tags_path), "<!-- AUDOCK:TAGS:BEGIN -->",
                       "<!-- AUDOCK:TAGS:END -->", inner),
        encoding="utf-8",
    )

    # 2) index.md maps list
    maps = []
    for p in md_files(VAULT / "maps"):
        fm, _ = parse_frontmatter(read(p))
        maps.append((fm.get("title") or p.stem, fm.get("id") or p.stem))
    maps_inner = ("\n".join(f"- [[{mid}|{title}]]" for title, mid in sorted(maps))
                  if maps else "- (none yet)")
    index_path = VAULT / "index.md"
    index_path.write_text(
        _replace_block(read(index_path), "<!-- AUDOCK:MAPS:BEGIN -->",
                       "<!-- AUDOCK:MAPS:END -->", maps_inner),
        encoding="utf-8",
    )
    print(f"reindexed: {len(tag_map)} tags, {len(maps)} maps")


LINK_RE = re.compile(r"\[\[([^\]|#]+)(?:[#|][^\]]*)?\]\]")
_FENCE_RE = re.compile(r"```.*?```", re.DOTALL)
_COMMENT_RE = re.compile(r"<!--.*?-->", re.DOTALL)
_INLINE_RE = re.compile(r"`[^`]*`")


def _strip_noise(body):
    """Drop code fences, HTML comments, and inline code so only real prose links remain.
    Illustrative links in examples/templates/docs live in exactly those regions."""
    body = _FENCE_RE.sub("", body)
    body = _COMMENT_RE.sub("", body)
    body = _INLINE_RE.sub("", body)
    return body


def _links(body):
    return LINK_RE.findall(_strip_noise(body))


def _resolvable_names():
    """Set of lowercased names that a [[link]] may legitimately target."""
    names = set()
    for p in md_files():
        fm, _ = parse_frontmatter(read(p))
        for v in (fm.get("id"), fm.get("title"), p.stem):
            if v:
                names.add(str(v).lower())
        for a in as_list(fm.get("aliases")):
            names.add(a.lower())
    return names


# Auto-generated indexes list every note; links from them are not semantic backlinks.
GENERATED = {"tags.md", "index.md"}


def cmd_doctor(args):
    names = _resolvable_names()
    notes, incoming, broken = [], {}, []
    for p in md_files():
        fm, body = parse_frontmatter(read(p))
        rel = str(p.relative_to(VAULT))
        if fm.get("type") == "note":
            notes.append((p, fm))
        # Generated indexes and the journal list/mention notes but aren't semantic backlinks;
        # source bodies are verbatim captures (any [[...]] in them is incidental, not a link).
        if rel in GENERATED or fm.get("type") in ("journal", "source"):
            continue
        for target in _links(body):
            tgt = target.strip()
            if tgt.lower() not in names:
                broken.append((rel, tgt))
            else:
                incoming[tgt.lower()] = incoming.get(tgt.lower(), 0) + 1

    # orphans: type==note with no incoming link by id/title/filename
    orphans = []
    for p, fm in notes:
        keys = {str(fm.get("id", "")).lower(), str(fm.get("title", "")).lower(), p.stem.lower()}
        keys |= {a.lower() for a in as_list(fm.get("aliases"))}
        if not (keys & set(incoming)):
            orphans.append(str(p.relative_to(VAULT)))

    # duplicate candidates: same slugified title
    by_slug = {}
    for p, fm in notes:
        by_slug.setdefault(slugify(str(fm.get("title", p.stem))), []).append(
            str(p.relative_to(VAULT)))
    dups = {k: v for k, v in by_slug.items() if len(v) > 1}

    # stale: updated older than STALE_DAYS
    cutoff = (date.today() - timedelta(days=STALE_DAYS)).isoformat()
    stale = []
    for p, fm in notes:
        stamp = str(fm.get("updated") or fm.get("created") or "")[:10]
        if stamp and stamp < cutoff:
            stale.append((str(p.relative_to(VAULT)), stamp))

    # names that resolve to an actual capture, for provenance checking
    source_names = set()
    for p in md_files(VAULT / "sources"):
        sfm, _ = parse_frontmatter(read(p))
        source_names.add(str(sfm.get("id", "")).lower())
        source_names.add(p.stem.lower())

    # notes whose sources: cite a capture that no longer exists (broken provenance)
    missing_src, underlinked = [], []
    for p, fm in notes:
        rel = str(p.relative_to(VAULT))
        for s in as_list(fm.get("sources")):
            tgts = _links(s) or [s]
            for t in tgts:
                if t.strip().lower() not in source_names:
                    missing_src.append(f"{rel} -> {t}")
        # under-linked: fewer than 2 outgoing wikilinks (weakly wired into the graph)
        body = parse_frontmatter(read(p))[1]
        if len(_links(body)) < 2:
            underlinked.append(rel)

    # locked = human-owned; informational so you can see what Claude must not touch
    locked = [str(p.relative_to(VAULT)) for p, fm in notes
              if str(fm.get("locked", "")).lower() == "true" or "locked" in as_list(fm.get("tags"))]

    def section(title, items):
        print(f"\n{title}: {len(items)}")
        for it in items:
            print(f"  - {it}")

    print(f"audock doctor — {len(notes)} notes ({len(locked)} locked/human-owned)")
    section("broken links", [f"{src} -> [[{tgt}]]" for src, tgt in broken])
    section("notes citing a missing source", missing_src)
    section("orphan notes (no backlinks)", orphans)
    section("under-linked notes (< 2 links)", underlinked)
    section("duplicate-title candidates", [f"{k}: {', '.join(v)}" for k, v in dups.items()])
    section(f"stale notes (> {STALE_DAYS}d)", [f"{p} ({s})" for p, s in stale])
    if not (broken or missing_src or orphans or underlinked or dups or stale):
        print("\nall clear ✓")


